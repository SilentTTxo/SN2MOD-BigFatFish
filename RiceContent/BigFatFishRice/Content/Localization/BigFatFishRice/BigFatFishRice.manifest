{"FormatVersion": 1, "Namespace": "", "Subnamespaces": [{"Namespace": "BigFatFishRice", "Children": [{"Source": {"Text": "Sea Rice Grain"}, "Keys": [{"Key": "GrainName", "Path": "BigFatFishRice"}]}, {"Source": {"Text": "Sea Rice"}, "Keys": [{"Key": "PlantName", "Path": "BigFatFishRice"}]}, {"Source": {"Text": "Plant in an aquafarm with the builder. Keep some grains for replanting."}, "Keys": [{"Key": "GrainDescription", "Path": "BigFatFishRice"}]}, {"Source": {"Text": "Grow sea rice in a planter. Harvest the ripe panicles at the crown."}, "Keys": [{"Key": "PlantDescription", "Path": "BigFatFishRice"}]}, {"Source": {"Text": "Plant sea rice in a planter."}, "Keys": [{"Key": "BuildDescription", "Path": "BigFatFishRice"}]}, {"Source": {"Text": "Sea Rice: {0}%"}, "Keys": [{"Key": "Growth", "Path": "BigFatFishRice"}]}, {"Source": {"Text": "Steamed Rice"}, "Keys": [{"Key": "FoodName", "Path": "BigFatFishRice"}]}, {"Source": {"Text": "Freshly steamed sea rice. Restores 25 food. Drop a bowl for more than 3 seconds to attract a new Big Fat Fish."}, "Keys": [{"Key": "FoodDescription", "Path": "BigFatFishRice"}]}, {"Source": {"Text": "Steam 1 sea rice grain with 1 water."}, "Keys": [{"Key": "MealDescription", "Path": "BigFatFishRice"}]}]}]}