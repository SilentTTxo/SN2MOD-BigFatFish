{"FormatVersion": 2, "Namespace": "", "Subnamespaces": [{"Namespace": "BigFatFishRice", "Children": [{"Key": "GrainName", "Source": {"Text": "Sea Rice Grain"}, "Translation": {"Text": "海稻"}}, {"Key": "PlantName", "Source": {"Text": "Sea Rice"}, "Translation": {"Text": "海稻"}}, {"Key": "GrainDescription", "Source": {"Text": "Plant in an aquafarm with the builder. Keep some grains for replanting."}, "Translation": {"Text": "使用建造器在种植槽栽种，留一部分海稻再种。"}}, {"Key": "PlantDescription", "Source": {"Text": "Grow sea rice in a planter. Harvest the ripe panicles at the crown."}, "Translation": {"Text": "在种植槽栽种海稻，采收顶部成熟的稻穗。"}}, {"Key": "BuildDescription", "Source": {"Text": "Plant sea rice in a planter."}, "Translation": {"Text": "在种植槽里栽种海稻。"}}, {"Key": "Growth", "Source": {"Text": "Sea Rice: {0}%"}, "Translation": {"Text": "海稻：{0}%"}}, {"Key": "FoodName", "Source": {"Text": "Steamed Rice"}, "Translation": {"Text": "大白饭"}}, {"Key": "FoodDescription", "Source": {"Text": "Freshly steamed sea rice. Restores 25 food. Drop a bowl for more than 3 seconds to attract a new Big Fat Fish."}, "Translation": {"Text": "热腾腾的大白饭，食用恢复 25 饱食度。丢下一碗超过 3 秒，会引来一只新的大肥鱼。"}}, {"Key": "MealDescription", "Source": {"Text": "Steam 1 sea rice grain with 1 water."}, "Translation": {"Text": "使用 1 份海稻和 1 份净水蒸制。"}}]}]}