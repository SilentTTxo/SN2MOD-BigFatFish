{"FormatVersion": 2, "Namespace": "", "Subnamespaces": [{"Namespace": "BigFatFishRice", "Children": [{"Key": "GrainName", "Source": {"Text": "Sea Rice Grain"}, "Translation": {"Text": "Sea Rice Grain"}}, {"Key": "PlantName", "Source": {"Text": "Sea Rice"}, "Translation": {"Text": "Sea Rice"}}, {"Key": "GrainDescription", "Source": {"Text": "Plant in an aquafarm with the builder. Keep some grains for replanting."}, "Translation": {"Text": "Plant in an aquafarm with the builder. Keep some grains for replanting."}}, {"Key": "PlantDescription", "Source": {"Text": "Grow sea rice in a planter. Harvest the ripe panicles at the crown."}, "Translation": {"Text": "Grow sea rice in a planter. Harvest the ripe panicles at the crown."}}, {"Key": "BuildDescription", "Source": {"Text": "Plant sea rice in a planter."}, "Translation": {"Text": "Plant sea rice in a planter."}}, {"Key": "Growth", "Source": {"Text": "Sea Rice: {0}%"}, "Translation": {"Text": "Sea Rice: {0}%"}}, {"Key": "FoodName", "Source": {"Text": "Steamed Rice"}, "Translation": {"Text": "Steamed Rice"}}, {"Key": "FoodDescription", "Source": {"Text": "Freshly steamed sea rice. Restores 25 food. Drop a bowl for more than 3 seconds to attract a new Big Fat Fish."}, "Translation": {"Text": "Freshly steamed sea rice. Restores 25 food. Drop a bowl for more than 3 seconds to attract a new Big Fat Fish."}}, {"Key": "MealDescription", "Source": {"Text": "Steam 1 sea rice grain with 1 water."}, "Translation": {"Text": "Steam 1 sea rice grain with 1 water."}}]}]}