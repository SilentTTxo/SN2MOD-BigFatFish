# Track this mod's source and selected release files, not the local toolchain.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/project.json
!/SAVE_INTEGRATION.md

!/Runtime/
/Runtime/*
!/Runtime/BigFatFish/
!/Runtime/BigFatFishRice/

!/RiceContent/
/RiceContent/*
!/RiceContent/BigFatFishRice/
/RiceContent/BigFatFishRice/*
!/RiceContent/BigFatFishRice/BigFatFishRice.uplugin
!/RiceContent/BigFatFishRice/Content/

!/Scripts/
/Scripts/test_runtime.lua
/Scripts/update_docs_v041.py

!/Docs/
/Docs/*
!/Docs/BigFatFish_User_Guide_EN_ZH.md
!/Docs/BigFatFish_Nexus_Description_EN_ZH.md
!/Docs/BigFatFish_Rice_Prototype_EN_ZH.md
!/Docs/BigFatFish_Model_Inventory_EN_ZH.md

!/SourceAssets/
/SourceAssets/*
!/SourceAssets/WhaleGirl_Swim_Preview.blend
!/SourceAssets/asset_manifest.json
!/SourceAssets/Export/
!/SourceAssets/Rice/
/SourceAssets/Export/*
!/SourceAssets/Export/WhaleGirl_Swim.fbx
!/SourceAssets/Export/BigFatFish_GrabEat.fbx
!/SourceAssets/Export/WhaleGirl_Swim.glb
!/SourceAssets/Export/Textures/

!/ContentProject/
/ContentProject/*
!/ContentProject/Subnautica2.uproject
!/ContentProject/Config/
!/ContentProject/Content/
/ContentProject/Content/*
!/ContentProject/Content/Mods/
/ContentProject/Content/Mods/*
!/ContentProject/Content/Mods/BigFatFish/

!/Build/
/Build/*
!/Build/package_manifest.json
!/Build/Package/
/Build/Package/*
!/Build/Package/LogicMods/
/Build/Package/LogicMods/*
!/Build/Package/LogicMods/BigFatFish/
!/Build/Releases/
/Build/Releases/*
!/Build/Releases/BigFatFish-*.zip
!/Build/Releases/BigFatFish-*.manifest.json
!/Build/Releases/BigFatFishRice-*.zip
!/Build/Releases/BigFatFishRice-*.manifest.json

# Generated files and local configuration are never versioned.
__pycache__/
*.py[cod]
node_modules/
*.tmp
*.bak
*.blend1
*.blend2
.env
.env.*
project.local.json
.DS_Store
Thumbs.db
